---
// The home hero: a full-bleed dark plate under the masthead running a WebGPU
// perspective grid — grey-white traffic streaks, faint stars — that behaves
// like a lattice of strings: the camera sways and dollies with the pointer,
// the lines nearest the cursor part around it, and a click strums the nearby
// columns and rows. A click in the sky instead calls down a green lightning
// bolt on the horizon — vertical, far out, like real lightning, where the
// click only picks the spot — and a citron pulse rides the struck column in
// from the distance toward the viewer. The site's only client JS. Three
// tiers, all silent: no
// `navigator.gpu` means the plate stays a flat dark ground (the CSS below
// carries the hero on its own); `prefers-reduced-motion` renders exactly one
// static frame; otherwise it animates, pausing whenever the plate is
// scrolled off-screen.
//
// Startup is two pipelines from one shader source: a light one without the
// strum code paints within tens of milliseconds, then the full one is
// compiled and swapped in. Shader compile time varies wildly by browser and
// GPU driver, so all per-string math (the ringing) runs on the CPU each frame
// and reaches the shader as small tables — the shader only does lookups.
---

<section class="plate">
  <canvas id="sig-c" aria-hidden="true"></canvas>
  <div class="inwrap"><slot /></div>
</section>

<style>
  .plate {
    position: relative;
    /* full-bleed breakout from the 860px shell; body clips the scrollbar sliver */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    height: clamp(520px, 72svh, 820px);
    background: #0b0b0d;
    border-bottom: 2px solid var(--rule);
    overflow: hidden;
  }
  canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0;
    transition: opacity 700ms ease;
  }
  canvas.on { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { canvas { transition: none; } }
  .inwrap {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
    padding: 72px 36px 0;
  }
  /* slotted hero content carries the page scope, so these must be :global */
  .inwrap :global(h1) { color: #f4f4f2; font-size: 50px; letter-spacing: -1.6px; line-height: 1.02; max-width: 13ch; margin: 0 0 18px; }
  .inwrap :global(.stamp) { margin: 0 0 22px; }
  .inwrap :global(.intro) { color: rgba(232, 232, 228, 0.62); }
  .inwrap :global(.intro b) { color: #fbfbf9; }
  @media (max-width: 620px) {
    .plate { height: clamp(460px, 64svh, 640px); }
    .inwrap { padding: 48px 20px 0; }
    .inwrap :global(h1) { font-size: 34px; letter-spacing: -1px; }
  }
</style>

<script>
  // ---- shader ---------------------------------------------------------------
  // Uniform layout (floats): see the offsets in draw() — 1436 floats, 5744 bytes.
  const WGSL_HEAD = /* wgsl */ `
struct U {
  res    : vec2f,
  mouse  : vec2f,
  time   : f32,
  aspect : f32,
  dpr    : f32,
  ptrOn  : f32,
  hit    : vec2f,            // cursor's floor point (x, z), from JS floorHit()
  zapN   : f32,             // live lightnings — the shader loops only this far
  pad    : f32,
  ev     : array<vec4f, 4>,  // per strum: (first column, first row) of its 7-string window
  ca     : array<vec4f, 8>,  // per strum: column displacements, 8 slots (7 strings + a zero)
  ra     : array<vec4f, 8>,  // per strum: row displacements
  cf     : array<vec4f, 8>,  // per strum: column flashes
  rf     : array<vec4f, 8>,  // per strum: row flashes
  zc     : array<vec4f, 64>, // per lightning: (column, strike z, pulse head z, pulse brightness)
  zb     : array<vec4f, 64>, // per lightning: (bolt intensity, bolt width, 0, 0)
  zn     : array<vec4f, 192>, // per lightning: 6 bolt nodes in aspect NDC, packed (xy, zw)
};
@group(0) @binding(0) var<uniform> u : U;

// camera feel — mirrored in the JS floorHit(); change both or neither
const SWAY  = 1.8;   // look-around with the pointer
const DOLLY = 1.0;   // camera slides sideways / up-down with the pointer

@vertex
fn vs(@builtin(vertex_index) vi : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
  return vec4f(p[vi], 0.0, 1.0);
}

fn hash1(n : f32) -> f32 { return fract(sin(n * 127.1) * 43758.5453123); }

fn streak_color(s : f32, s2 : f32) -> vec3f {
  let dim = vec3f(0.55, 0.57, 0.55);
  let brt = vec3f(0.95, 0.97, 0.95);
  return mix(dim, brt, step(0.80, s)) * (0.35 + 0.55 * s2);
}
`;

  // light pipeline: the grid with no strings behaviour — compiles in ~20ms anywhere
  const WGSL_STUB = /* wgsl */ `
fn warp(p : vec2f) -> vec2f { return p; }
fn strum_glow(p : vec2f, gX : f32, gZ : f32) -> f32 { return 0.0; }
fn zap_line(p : vec2f, gX : f32, wX : f32) -> f32 { return 0.0; }
fn bolt_glow(sp : vec2f) -> vec2f { return vec2f(0.0); }
`;

  // full pipeline: the lattice as strings. Deliberately no transcendentals inside
  // the loops — only table lookups and polynomial bumps — to keep compile fast.
  const WGSL_STRINGS = /* wgsl */ `
const STRUM_HALF = 3.0;
fn bump(t : f32) -> f32 { let s = clamp(1.0 - t * t, 0.0, 1.0); return s * s; }
// string index within a strum's window → table slot; anything outside → slot 7 (always zero)
fn slot(d : f32) -> i32 { let i = i32(clamp(d, -1.0, 8.0)); return select(7, i, i >= 0 && i <= 6); }

// domain warp of the floor plane: lines part around the cursor like strings
// under a finger, and the columns/rows near a strum ring and settle.
fn warp(p : vec2f) -> vec2f {
  let c = u.hit;
  let dx = p.x - c.x; let dz = p.y - c.y;
  var out = p;
  let ex = exp(-dz * dz / 5.0); let ez = exp(-dx * dx / 5.0);
  out.x -= dx * 0.7 * exp(-dx * dx / 1.4) * ex * u.ptrOn;
  out.y -= dz * 0.7 * exp(-dz * dz / 1.4) * ez * u.ptrOn;
  let kx = round(p.x); let kz = round(p.y);
  for (var i = 0; i < 4; i = i + 1) {
    let e = u.ev[i];
    let envX = bump((p.y - (e.y + STRUM_HALF)) / 6.5);
    let envZ = bump((p.x - (e.x + STRUM_HALF)) / 6.5);
    // the three strings nearest this pixel, in each direction
    for (var n = -1; n <= 1; n = n + 1) {
      let j = kx + f32(n);
      let sj = slot(j - e.x);
      out.x -= u.ca[i * 2 + sj / 4][sj % 4] * bump((p.x - j) / 0.95) * envX;
      let m = kz + f32(n);
      let sm = slot(m - e.y);
      out.y -= u.ra[i * 2 + sm / 4][sm % 4] * bump((p.y - m) / 0.95) * envZ;
    }
  }
  return out;
}

// a brief flash on each string as the strum reaches it
fn strum_glow(p : vec2f, gX : f32, gZ : f32) -> f32 {
  var l = 0.0;
  let kx = round(p.x); let kz = round(p.y);
  for (var i = 0; i < 4; i = i + 1) {
    let e = u.ev[i];
    let sj = slot(kx - e.x);
    let sm = slot(kz - e.y);
    l += gX * u.cf[i * 2 + sj / 4][sj % 4] * bump((p.y - (e.y + STRUM_HALF)) / 5.0)
       + gZ * u.rf[i * 2 + sm / 4][sm % 4] * bump((p.x - (e.x + STRUM_HALF)) / 5.0);
  }
  return l;
}

fn bump2(d2 : f32, r2 : f32) -> f32 { let s = clamp(1.0 - d2 / r2, 0.0, 1.0); return s * s; }

// a lightning strike far out lights its column: a citron pulse travels from the
// strike point in toward the viewer, and the lines around the impact flash briefly
fn zap_line(p : vec2f, gX : f32, wX : f32) -> f32 {
  var l = 0.0;
  let kx = round(p.x);
  // where columns go subpixel the crisp line aliases into dashes — fade it out
  // there and let the smooth neon body carry the distant leg on its own
  let solid = 1.0 - smoothstep(0.45, 0.85, wX);
  let n = i32(u.zapN); // dynamic bound: dead slots cost nothing, and nothing unrolls
  for (var i = 0; i < n; i = i + 1) {
    let e = u.zc[i];
    let on = select(0.0, e.w, abs(kx - e.x) < 0.5);
    let behind = p.y - e.z; // the tail streams back toward the strike point
    let a = clamp(1.0 - behind / 9.0, 0.0, 1.0) * smoothstep(-0.8, 0.0, behind) * step(p.y, e.y + 0.5);
    // the line itself, nothing around it — no glow, no floor lights
    l += gX * on * solid * a * a;
  }
  return l;
}

// squared distance to a segment — the bolt is a 5-segment polyline per event,
// its nodes computed on the CPU and read here as-is
fn seg2(sp : vec2f, a : vec2f, b : vec2f) -> f32 {
  let ab = b - a;
  let h = clamp(dot(sp - a, ab) / max(dot(ab, ab), 1e-6), 0.0, 1.0);
  let d = sp - a - ab * h;
  return dot(d, d);
}

// screen-space bolt glow: (core, halo)
fn bolt_glow(sp : vec2f) -> vec2f {
  var core = 0.0;
  var halo = 0.0;
  let n = i32(u.zapN);
  for (var i = 0; i < n; i = i + 1) {
    let inten = u.zb[i].x;
    if (inten <= 0.0) { continue; } // uniform branch — dead slots cost nothing
    let w = u.zb[i].y;
    var d2 = 1e9;
    for (var s = 0; s < 5; s = s + 1) {
      let va = u.zn[i * 3 + s / 2];
      let vb = u.zn[i * 3 + (s + 1) / 2];
      let a = select(va.zw, va.xy, s % 2 == 0);
      let b = select(vb.zw, vb.xy, (s + 1) % 2 == 0);
      d2 = min(d2, seg2(sp, a, b));
    }
    let ww = w * w;
    core += inten * bump2(d2, ww);
    halo += inten * ww * 14.0 / (ww * 14.0 + d2 + 1e-7);
  }
  return vec2f(core, halo);
}
`;

  const WGSL_TAIL = /* wgsl */ `
fn camera() -> vec3f {
  return vec3f(u.mouse.x * 1.1 * DOLLY, 1.7 - u.mouse.y * 0.4 * DOLLY, 0.0);
}

// floor plane under the camera; returns (light rgb, grid mask). p is (x, z).
// Derivatives stay in uniform control flow.
fn layer(rd : vec3f, cam : vec3f) -> vec4f {
  let denomRaw = -rd.y;
  let denom = max(denomRaw, 0.02);
  let t = cam.y / denom;
  let vis = smoothstep(0.012, 0.05, denomRaw);
  let fog = exp(-t * 0.03);
  let p = warp(cam.xz + rd.xz * t);

  let wX = fwidth(p.x);
  let wZ = fwidth(p.y);
  let dX = 0.5 - abs(fract(p.x) - 0.5);
  let dZ = 0.5 - abs(fract(p.y) - 0.5);
  let gX = 1.0 - smoothstep(0.0, wX * 1.4, dX);
  let gZ = 1.0 - smoothstep(0.0, wZ * 1.4, dZ);
  let grid = max(gX, gZ) * fog * vis;

  let id = round(p.x);
  let lat = abs(p.x - id);
  let lm = 1.0 - smoothstep(0.0, max(wX * 1.8, 0.015), lat);
  let halo = pow(clamp(1.0 - lat / 0.35, 0.0, 1.0), 2.0) * 0.22;
  var streak = vec3f(0.0);
  for (var k = 0; k < 3; k = k + 1) {
    let fk = f32(k);
    let s  = hash1(id * 3.71 + fk * 91.7 + 4.7);
    let s2 = hash1(id * 9.13 + fk * 17.9 + 4.7);
    let spd = 6.0 + s * 12.0;
    let len = 6.0 + s2 * 10.0;
    let span = 46.0;
    let phase = u.time * spd / span + s2 * 7.13;
    let head = span * (1.0 - fract(phase));
    let behind = p.y - head;
    let a = clamp(1.0 - behind / len, 0.0, 1.0) * smoothstep(-1.2, 0.0, behind);
    let gate = step(0.60, hash1(id * 27.7 + fk * 57.3 + floor(phase) * 3.31 + 4.7));
    streak += streak_color(s, s2) * pow(a, 2.0) * gate;
  }
  streak *= (lm + halo) * fog * vis;
  streak += vec3f(0.72, 1.0, 0.08) * strum_glow(p, gX, gZ) * fog * vis;
  // the pulse mostly ignores the fog: an energetic event should out-glow the haze
  streak += vec3f(0.72, 1.0, 0.08) * zap_line(p, gX, wX) * pow(fog, 0.35) * vis;
  return vec4f(streak, grid);
}

@fragment
fn fs(@builtin(position) fc : vec4f) -> @location(0) vec4f {
  var uv = (fc.xy / u.res) * 2.0 - 1.0;
  uv = vec2f(uv.x * u.aspect, -uv.y);
  let pitch = 0.24 + u.mouse.y * 0.11 * SWAY;
  let yaw = u.mouse.x * 0.22 * SWAY;
  var rd = normalize(vec3f(uv.x, uv.y - pitch, 1.55));
  let cy = cos(yaw); let sy = sin(yaw);
  rd = vec3f(rd.x * cy + rd.z * sy, rd.y, rd.z * cy - rd.x * sy);

  let fl = layer(rd, camera());
  var col = vec3f(0.043, 0.043, 0.051);
  col += vec3f(0.38, 0.38, 0.42) * fl.w * 0.28;
  col += fl.xyz;
  col += vec3f(0.5, 0.5, 0.52) * exp(-abs(rd.y) * 30.0) * 0.14;

  // sparse dim stars, fixed to the camera's look direction
  let sp = rd.xy / rd.z * 10.0;
  let cell = floor(sp);
  let hs = hash1(cell.x * 91.7 + cell.y * 133.3);
  let spos = cell + vec2f(hash1(hs * 391.0), hash1(hs * 173.0));
  let sd = length(sp - spos);
  let sw = fwidth(sp.x) * 1.5;
  let star = (1.0 - smoothstep(0.025 - sw, 0.025 + sw, sd)) * step(0.6, hs);
  let twinkle = 0.6 + 0.4 * sin(u.time * (0.4 + hs * 1.4) + hs * 43.0);
  let skyM = smoothstep(0.03, 0.18, rd.y);
  col += vec3f(0.7, 0.72, 0.75) * star * (0.12 + 0.4 * hash1(hs * 57.0)) * twinkle * skyM;

  // lightning bolt, drawn in screen space over sky and floor alike
  let bolt = bolt_glow(uv);
  col += vec3f(0.82, 1.0, 0.58) * bolt.x * 1.35 + vec3f(0.45, 0.85, 0.10) * bolt.y * 0.85;
  // and the sky itself flickers faintly while a bolt crackles — capped, so
  // stacked bolts don't wash the whole sky out
  var liftSum = 0.0;
  let nz = i32(u.zapN);
  for (var i = 0; i < nz; i = i + 1) { liftSum += u.zb[i].x; }
  let lift = min(liftSum, 1.2) * 0.035;
  col += vec3f(0.42, 0.58, 0.24) * lift * smoothstep(-0.02, 0.14, rd.y);

  let q = fc.xy / u.res - 0.5;
  col *= 1.0 - dot(q, q) * 0.35;
  col += (hash1(dot(fc.xy, vec2f(13.17, 7.31))) - 0.5) * 0.008;
  return vec4f(col, 1.0);
}
`;
  const wgsl = (strings) => WGSL_HEAD + (strings ? WGSL_STRINGS : WGSL_STUB) + WGSL_TAIL;

  // ---- strings physics (CPU side) --------------------------------------------
  // must match the WGSL consts of the same name
  const SWAY = 1.8;
  const DOLLY = 1.0;
  const STRUM_W = 2.2;    // how many strings out a strum reaches
  const STRUM_DT = 0.045; // delay per string — the outward sweep
  const hash1 = (n) => { const x = Math.sin(n * 127.1) * 43758.5453123; return x - Math.floor(x); };
  // one string's transverse motion at local age a; every string has its own pitch
  const ring = (a, j) => {
    if (a <= 0) return 0;
    const w = 14 + 4 * hash1(j * 7.3 + 1.7);
    return ((Math.sin(a * w) + 0.4 * Math.sin(a * w * 2.1 + 1)) / 1.4) * Math.exp(-a * 1.9);
  };

  // uniform float offsets
  const U_EV = 12, U_CA = 28, U_RA = 60, U_CF = 92, U_RF = 124;
  const U_ZC = 156, U_ZB = 412, U_ZN = 668, U_LEN = 1436, ZAP_MAX = 64;

  const canvas = document.getElementById('sig-c');

  async function start(cv) {
    const adapter = await navigator.gpu.requestAdapter();
    if (!adapter) return;
    const device = await adapter.requestDevice();
    const ctx = cv.getContext('webgpu');
    if (!ctx) return;
    const format = navigator.gpu.getPreferredCanvasFormat();
    ctx.configure({ device, format, alphaMode: 'opaque' });

    const ubuf = device.createBuffer({
      size: U_LEN * 4,
      usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
    });
    const bgl = device.createBindGroupLayout({
      entries: [{ binding: 0, visibility: GPUShaderStage.FRAGMENT, buffer: {} }],
    });
    const layout = device.createPipelineLayout({ bindGroupLayouts: [bgl] });
    const makePipeline = (code) => {
      const module = device.createShaderModule({ code });
      return device.createRenderPipelineAsync({
        layout,
        vertex: { module, entryPoint: 'vs' },
        fragment: { module, entryPoint: 'fs', targets: [{ format }] },
        primitive: { topology: 'triangle-list' },
      });
    };
    const bind = device.createBindGroup({
      layout: bgl,
      entries: [{ binding: 0, resource: { buffer: ubuf } }],
    });

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // light pipeline first so the grid is on screen fast; the full one is compiled only
    // once the first frame has been presented (Safari's GPU process would otherwise
    // hold that frame back until the full compile finishes) and swaps in when ready
    let pipeline = await makePipeline(wgsl(false));
    let fullQueued = still; // reduced motion: one static frame, the light pipeline is all it needs
    const queueFull = () => {
      fullQueued = true;
      device.queue.onSubmittedWorkDone()
        .then(() => makePipeline(wgsl(true)))
        .then((p) => { pipeline = p; })
        .catch(() => {});
    };

    const uarr = new Float32Array(U_LEN);
    let simT = still ? 11.0 : 0;
    let mx = 0, my = 0, tx = 0, ty = 0; // smoothed / target pointer, drives the camera
    let px = 0, py = 0;                 // raw pointer, drives the floor hit
    let pOn = 0, pOnT = 0;
    let hx = 0, hz = 6;                 // cursor's floor point, lightly smoothed
    // strum ring buffer: column, row, start time
    const strums = [0, 1, 2, 3].map(() => ({ cx: 0, cz: 0, t0: -1e3 }));
    let strumIx = 0;
    // live lightnings: column, strike z, start time, jitter seed — a list, not
    // a ring buffer: dead ones leave, and a click only ever evicts the oldest
    // when all ZAP_MAX uniform slots hold lightnings still alive — the
    // shader loops only over the live count, so the table is big for free
    let zaps = [];

    // mirrors the WGSL camera exactly — change both or neither
    const camPose = (ax = mx, ay = my) => ({
      pitch: 0.24 + ay * 0.11 * SWAY,
      yaw: ax * 0.22 * SWAY,
      camX: ax * 1.1 * DOLLY,
      camH: 1.7 - ay * 0.4 * DOLLY,
    });
    const rayDir = (nx, ny, c) => {
      let x = nx * (cv.width / cv.height), y = -ny - c.pitch, z = 1.55;
      const l = Math.hypot(x, y, z); x /= l; y /= l; z /= l;
      const cy = Math.cos(c.yaw), sy = Math.sin(c.yaw);
      return [x * cy + z * sy, y, z * cy - x * sy];
    };
    // pointer position → floor (x, z), or null for sky
    const floorHit = (nx, ny) => {
      const c = camPose();
      const [rx, ry, rz] = rayDir(nx, ny, c);
      if (ry > -0.03) return null;
      const t = c.camH / -ry;
      return [c.camX + rx * t, rz * t];
    };
    // a sky click strikes deep beyond the horizon — the higher the click, the
    // deeper — and lands exactly under the click's azimuth: the floor point at
    // the strike depth projects back to the click's own screen x
    const skyStrike = (nx, ny) => {
      // aim with the camera's target pose, not the eased one: the camera is
      // still settling toward the cursor when the click lands, and the bolt
      // must stand under the cursor once it does
      const c = camPose(tx, ty);
      const [rx, ry, rz] = rayDir(nx, ny, c);
      const tFar = 40 + Math.min(1, Math.max(0, ry) * 3.5) * 20;
      // clamp the depth along the ray, not after the fact, so the strike
      // point still projects exactly onto the click
      const rzs = Math.max(rz, 0.15);
      const t2 = Math.max(34, Math.min(60, rzs * tFar)) / rzs;
      return [c.camX + rx * t2, rzs * t2];
    };
    // world floor point → aspect NDC (y up); the exact inverse of rayDir
    const project = (X, Z) => {
      const c = camPose();
      const dx = X - c.camX, dz = Z;
      const cy = Math.cos(c.yaw), sy = Math.sin(c.yaw);
      const vx = dx * cy - dz * sy, vz = dx * sy + dz * cy;
      const k = 1.55 / Math.max(vz, 0.1);
      return [vx * k, -c.camH * k + c.pitch];
    };

    // per-string ringing and flash for every live strum → uniform tables
    const fillTables = () => {
      for (let i = 0; i < 4; i++) {
        const s = strums[i];
        const age = simT - s.t0;
        const live = age >= 0 && age < 4;
        uarr[U_EV + i * 4] = s.cx - 3;
        uarr[U_EV + i * 4 + 1] = s.cz - 3;
        for (let k = 0; k < 7; k++) {
          let a = 0, r = 0, fl = 0;
          if (live) {
            const d = Math.abs(k - 3);
            const la = age - d * STRUM_DT;
            const fall = Math.exp(-((d / STRUM_W) ** 2));
            a = 0.3 * fall * ring(la, s.cx - 3 + k);
            r = 0.3 * fall * ring(la, s.cz - 3 + k + 100);
            fl = la > 0 ? fall * Math.exp(-la * 5) * 0.8 : 0;
          }
          uarr[U_CA + i * 8 + k] = a;
          uarr[U_RA + i * 8 + k] = r;
          uarr[U_CF + i * 8 + k] = fl;
          uarr[U_RF + i * 8 + k] = fl;
        }
      }
    };

    // the pulse rushes in from the distance and eases up as it nears:
    // dz/dt = -(6 + 0.35 z), solved in closed form below
    const ZAP_K = 0.35, ZAP_A = 6 / 0.35;
    const BOLT_LIFE = 0.45; // how long the bolt itself crackles
    // bolt flicker, strike flash, and the pulse's approach for every live
    // lightning → uniform tables; the bolt polyline is rebuilt every frame so
    // it stays pinned to its strike point while the camera sways
    const zapHead = (z) =>
      (z.z0 + ZAP_A) * Math.exp(-ZAP_K * Math.max(0, simT - z.t0 - 0.05)) - ZAP_A;
    const fillZaps = () => {
      zaps = zaps.filter((z) => zapHead(z) > -8); // done pulses free their slots
      for (let i = 0; i < zaps.length; i++) {
        const z = zaps[i];
        const age = simT - z.t0;
        const run = age - 0.05; // the pulse sets out as the bolt connects
        const head = zapHead(z);
        let boltI = 0;
        if (age < BOLT_LIFE) {
          const gate = hash1(z.seed + Math.floor(age / 0.05) * 7.7) > 0.3 ? 1 : 0.25;
          boltI = Math.exp(-age * 5.5) * gate;
        }
        // thin — the bolt stands far away, and distance is told by width
        const boltW = 0.0028 + 0.0038 * Math.exp(-age * 8);
        // the fog thins as the pulse nears, so it brightens on approach by
        // itself; keep the gain low enough that the line stays citron, not
        // clamped to white
        const lineB = run > 0 ? Math.min(1, run * 20) * 2.0 * Math.exp(-run * 0.18) : 0;
        uarr[U_ZC + i * 4] = z.j;
        uarr[U_ZC + i * 4 + 1] = z.z0;
        uarr[U_ZC + i * 4 + 2] = head;
        uarr[U_ZC + i * 4 + 3] = lineB;
        uarr[U_ZB + i * 4] = boltI;
        uarr[U_ZB + i * 4 + 1] = boltW;
        uarr[U_ZB + i * 4 + 2] = 0;
        uarr[U_ZB + i * 4 + 3] = 0;
        if (boltI > 0) {
          // the bolt stands on the horizon like real lightning: from high above
          // the frame straight down onto the strike point, zigzagging
          // horizontally, mid nodes re-jittered every 60ms
          const [ex, ey] = project(z.j, z.z0);
          const topX = ex + (hash1(z.seed + 3.1) - 0.5) * 0.1;
          const topY = 1.12;
          const shake = Math.floor(age / 0.06) * 51.3;
          for (let n = 0; n < 6; n++) {
            const f = n / 5;
            const amp = 0.04 * Math.sin(Math.PI * f);
            const jit = (hash1(z.seed + n * 13.7 + shake) - 0.5) * 2;
            uarr[U_ZN + i * 12 + n * 2] = topX + (ex - topX) * f + amp * jit;
            uarr[U_ZN + i * 12 + n * 2 + 1] = topY + (ey - topY) * f;
          }
        }
      }
    };

    const dpr = () => Math.min(devicePixelRatio || 1, 2);
    let shown = false;
    const draw = () => {
      uarr[0] = cv.width; uarr[1] = cv.height;
      uarr[2] = mx; uarr[3] = my;
      uarr[4] = simT;
      uarr[5] = cv.width / cv.height;
      uarr[6] = dpr();
      uarr[7] = pOn;
      uarr[8] = hx; uarr[9] = hz;
      uarr[10] = zaps.length;
      fillTables();
      fillZaps();
      device.queue.writeBuffer(ubuf, 0, uarr);
      const enc = device.createCommandEncoder();
      const pass = enc.beginRenderPass({
        colorAttachments: [{
          view: ctx.getCurrentTexture().createView(),
          loadOp: 'clear', clearValue: { r: 0, g: 0, b: 0, a: 1 }, storeOp: 'store',
        }],
      });
      pass.setPipeline(pipeline);
      pass.setBindGroup(0, bind);
      pass.draw(3);
      pass.end();
      device.queue.submit([enc.finish()]);
      if (!shown) {
        shown = true;
        cv.classList.add('on');
        if (!fullQueued) queueFull();
      }
    };

    const fit = () => {
      const r = cv.getBoundingClientRect();
      cv.width = Math.max(1, Math.round(r.width * dpr()));
      cv.height = Math.max(1, Math.round(r.height * dpr()));
      if (still) draw();
    };
    new ResizeObserver(fit).observe(cv);
    fit();

    if (still) return;

    const norm = (e) => {
      const r = cv.getBoundingClientRect();
      return [((e.clientX - r.left) / r.width) * 2 - 1, ((e.clientY - r.top) / r.height) * 2 - 1];
    };

    // playing the hero means clicking fast — don't let double-clicks select
    // the headline; deliberate drag selection still works
    cv.parentElement?.addEventListener('mousedown', (e) => {
      if (e.detail > 1) e.preventDefault();
    });
    addEventListener('pointermove', (e) => {
      const [nx, ny] = norm(e);
      px = nx; py = ny;
      tx = Math.max(-1.4, Math.min(1.4, nx));
      ty = Math.max(-1.4, Math.min(1.4, ny));
      pOnT = Math.abs(nx) <= 1 && Math.abs(ny) <= 1 ? 1 : 0;
    }, { passive: true });
    document.addEventListener('mouseleave', () => { pOnT = 0; });
    addEventListener('pointerdown', (e) => {
      const [nx, ny] = norm(e);
      if (Math.abs(nx) > 1 || Math.abs(ny) > 1) return;
      const hit = floorHit(nx, ny);
      if (hit) {
        const s = strums[strumIx];
        s.cx = Math.round(hit[0]); s.cz = Math.round(hit[1]); s.t0 = simT;
        strumIx = (strumIx + 1) % 4;
      } else {
        // sky click → a lightning bolt down onto the nearest column, far out
        const st = skyStrike(nx, ny);
        zaps.push({ j: Math.round(st[0]), z0: st[1], t0: simT, seed: Math.floor(simT * 63) % 997 });
        if (zaps.length > ZAP_MAX) zaps.shift();
      }
    });

    let raf = 0;
    let visible = true;
    let last = performance.now();
    const frame = (now) => {
      if (!visible) { raf = 0; return; }
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      simT += dt;
      mx += (tx - mx) * 0.1;
      my += (ty - my) * 0.1;
      const hit = floorHit(px, py);
      if (hit) { hx += (hit[0] - hx) * 0.5; hz += (hit[1] - hz) * 0.5; }
      pOn += ((hit ? pOnT : 0) - pOn) * 0.15;
      draw();
      raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      if (visible && !raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
    }).observe(cv);
    raf = requestAnimationFrame(frame);
  }

  if (canvas && 'gpu' in navigator) start(canvas).catch(() => {});
</script>
